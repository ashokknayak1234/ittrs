{
  "name": "ittrs",
  "account_id": "07cd025c64a5cb42a38bf8ae9ecf3c7b",
  "main": ".worker-source/worker.py",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "python_workers"
  ],
  "build": {
    "command": "python build_worker.py"
  },
  "rules": [
    {
      "type": "Data",
      "globs": [
        "config/*.yaml"
      ],
      "fallthrough": false
    }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "vars": {
    "APP_ENV": "production",
    "ADMIN_USER": "admin",
    "AI_PROVIDER": "workers-ai",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "OLLAMA_BASE_URL": "https://ollama.example.com",
    "OLLAMA_MODEL": "qwen2.5:1.5b",
    "OLLAMA_TIMEOUT_MS": "90000",
    "DATABASE_PROVIDER": "supabase",
    "SUPABASE_URL": "https://swmbgntzicyyaqseeucj.supabase.co"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}

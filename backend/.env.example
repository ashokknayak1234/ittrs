# Server secrets only. Copy to .env; keep it out of Git.
# Upload from backend/: uv run pywrangler secret bulk .env
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
SUPABASE_SECRET_KEY=sb_secret_replace_me
# For a legacy key, replace the line above with SUPABASE_SERVICE_ROLE_KEY=...
# Optional protected Ollama tunnel:
# OLLAMA_ACCESS_CLIENT_ID=replace_me
# OLLAMA_ACCESS_CLIENT_SECRET=replace_me
# Optional legacy API client authentication, never put this in frontend code:
# ITTRS_API_KEY=replace-with-a-unique-long-server-key
